# Copy to terraform.tfvars (gitignored). Each address must never have been
# used by another AWS account, closed ones included.
account_emails = {
  dev  = "you+pawpers-dev@example.com"
  prod = "you+pawpers-prod@example.com"
}

sso_admin = {
  user_name   = "you"
  email       = "you@example.com"
  given_name  = "First"
  family_name = "Last"
}
